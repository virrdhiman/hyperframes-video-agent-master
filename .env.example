# Copy this file to tools/.env and fill in real values, then: ln -sf tools/.env .env
# Nothing here is required to READ the repo — keys are only needed to RUN the pipelines.
# The tiers below tell you what each key unlocks. Start with the "core" ones.

# ── CORE (research + free stock — get the pipeline running) ─────────────────
SERPER_API_KEY=          # serper.dev — Google search/images + YouTube b-roll discovery (topic research)
PEXELS_API_KEY=          # pexels.com — free stock video/photo
PIXABAY_API_KEY=         # pixabay.com — free stock video/photo
FREESOUND_API_KEY=       # freesound.org — sound effects

# ── VOICE / CAPTIONS (optional — HyperFrames also ships LOCAL Kokoro TTS + Whisper) ─
ELEVENLABS_API_KEY=      # elevenlabs.io — premium TTS voiceover + transcription (aka XI_API_KEY)

# ── AI ASSET GENERATION (optional — only if you generate images/video/thumbnails) ──
REPLICATE_API_TOKEN=     # replicate.com — image/video models (e.g. Nano Banana, Wan i2v) + thumbnails
FAL_KEY=                 # fal.ai — image/video asset generation
GOOGLE_API_KEY=          # Google AI — Veo (video) + Imagen (image) generation

# ── PUBLISHING (optional — only if you auto-post) ──────────────────────────
PUBLER_API_KEY=          # publer.com — social publishing
PUBLER_WORKSPACE_ID=     # publer.com — target workspace id
