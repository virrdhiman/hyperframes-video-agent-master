# ── secrets (NEVER commit) ──────────────────────────────
.env
.env.*
!.env.example
tools/.env
**/.env
*.pem
*.key
credentials*.json
cred.json

# ── node ────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── build outputs / render artifacts ────────────────────
out/
renders/
snapshots/
.thumbnails/
*.log
# generated by build_composition.py — run it to regenerate
index.html
.waveform-cache

# ── heavy / fetched media (re-fetched or generated per video) ──
assets/
raw/
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.m4a

# ── large vendored binaries (re-downloadable) ───────────
tools/stock_fetcher/yt-dlp
**/yt-dlp

# ── OS / editor ─────────────────────────────────────────
.DS_Store
.idea/
*.swp

# ── OpenClaw agent state (Bella) — persona/memory, not project deliverables ──
.openclaw/
SOUL.md
IDENTITY.md
USER.md
MEMORY.md
HEARTBEAT.md
TOOLS.md
memory/
tools/heygen_session.json
*heygen_session*.json
*.session.json
**/session.json
*_cookies.json
heygen_pw_profile/

# ── QA / verify frame dumps (variants of snapshots/) ────
**/_snap/
**/_snap_*/
**/_qa/
**/_qa[0-9]*/
**/_qa_*/
**/_qc/
**/_lipverify/
**/_whitecheck/
**/_tmp/
**/snapshots_*/

# ── stray archives / editor backups ─────────────────────
*.zip
*.bak
*.bak.*
*.json.bak*

# ── generated / vendor / heavy caches ───────────────────
logs/
models/
topic_fetch/
projects/_pending_designmd_assets/

# ── throwaway one-off scripts (kept locally, not tracked) ─
tools/_*
projects/**/_*.sh
projects/**/_*.txt
projects/**/_*.js
projects/**/_*.py
